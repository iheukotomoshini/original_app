<div class="card">
  <%= link_to image_tag(stock.image), stock_path(stock.id), class: "card__img" %>
  <div class="card__body">
    <%= link_to stock.title, stock_path(stock.id), class: "card__title" %>
    <p class="card__summary">
      <%= stock.catch_copy %>
    </p>
    <%= link_to stock.user.name, user_path(stock.user.id), class: "card__user" %>
  </div>
</div>