<div class="side-bar-header">
  <div class="header-name">
    <div class="inner">
      <% if user_signed_in? %>
        <div class="greeting"> 
          ログイン者 :  
          <%= link_to current_user.employee_name, user_path(current_user.id), class: :greeting__link %>
        さん
        </div>
        <div class="greeting-logout">
          <li><%= link_to 'ログアウト', destroy_user_session_path, data: {turbo_method: :delete}, class: "logout" %></li> 
        </div>
      <% else %>
        <div class="greeting">
          <li><%= link_to 'ログイン', new_user_session_path, class: "login" %></li>
          <li><%= link_to '新規登録', new_user_registration_path, class: "sign-up" %></li>
        </div>
      <% end %>

      <div class="card__wrapper">
        <% render partial: "stock", collection: @stocks %>
      </div>
    </div>
  </div>
</div>